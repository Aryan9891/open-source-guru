# Copy to .env and adjust. All apps read this file in development.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker compose). POSTGRES_PORT is the host port; keep it in sync with DATABASE_URL.
POSTGRES_PORT=5433
DATABASE_URL=postgres://osg:osg@localhost:5433/osg

# API
API_HOST=0.0.0.0
API_PORT=4000
# Signs sessions and encrypts stored GitHub tokens: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Admins: comma-separated GitHub logins given the admin role at API startup and on first sign-in,
# to create the first admin. Others are then granted from /admin-dashboard/users. Removing a login
# here doesn't remove the role. Example: ADMIN_LOGINS=octocat,hubot
ADMIN_LOGINS=

# Web app: public URL (used in links and as the sign-in origin) and where /api/* is forwarded
WEB_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000

# GitHub App (see docs/github-app.md)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Absolute path: each app runs from its own folder.
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/open-source-guru/secrets/github-app.private-key.pem
GITHUB_APP_INSTALLATION_ID=

# Email (Mailpit in development: web UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Open Source Guru <notifications@open-source-guru.dev>"
# Signs links in emails (unsubscribe, address verification): openssl rand -base64 32
EMAIL_TOKEN_SECRET=
