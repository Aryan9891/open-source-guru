# Production settings for docker-compose.prod.yml. Copy to `.env` in the deploy directory on the
# VPS (never commit it). docker compose reads it for ${...} values and passes it to the
# api, worker and migrate containers.

# Public domain of the web app, used in links (WEB_URL). Its routing and certificate are set up
# in the shared nginx (vps-nginx: conf.d/open-source-guru.conf).
DOMAIN=open-source-guru.dev

# Ports published on 127.0.0.1 for the host's nginx. They must match conf.d/open-source-guru.conf
# in vps-nginx and be free on the server (retrouve-moi uses its own).
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432

LOG_LEVEL=info

# PostgreSQL. The password goes into a connection URL, so use URL-safe characters: openssl rand -hex 32
POSTGRES_USER=osg_user
POSTGRES_PASSWORD=osg_password
POSTGRES_DB=osg_database

# Signs sessions and encrypts stored GitHub tokens: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me

# GitHub App. The private key is the file secrets/github-app.pem next
# to the compose file; the containers read it as a Docker secret.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_INSTALLATION_ID=

# Email (production SMTP provider, e.g. smtps://user:password@smtp.example.com:465)
SMTP_URL=
EMAIL_FROM="Open Source Guru <notifications@open-source-guru.dev>"
# Signs links in emails (unsubscribe, address verification): openssl rand -base64 32
EMAIL_TOKEN_SECRET=change_me
