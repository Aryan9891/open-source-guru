{
  "name": "@osg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:schema": "auth generate --config scripts/auth-schema.config.ts --output ../../packages/core/src/db/schema/auth.ts --yes && biome format --write ../../packages/core/src/db/schema/auth.ts",
    "openapi": "node scripts/openapi.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.7",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@osg/core": "workspace:*",
    "@osg/emails": "workspace:*",
    "better-auth": "^1.7.7",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "auth": "~1.7.7",
    "msw": "^3.0.3",
    "pino-pretty": "^13.2.0"
  }
}
